<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- NOTE on file-access permissions (issue #3): a terminal that spawns arbitrary
     child processes can never adopt App Sandbox, so sandbox-only file entitlements
     (files.user-selected.*, files.downloads.*) are inert here and were removed.
     TCC permission persistence comes from a STABLE code signature (see SIGNING.md)
     plus the in-app permissions onboarding (Full Disk Access / folder priming). -->
<dict>
    <!-- Audio/Video capture for CLI tools (transcription, voice agents) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- Hardened runtime: terminal launches arbitrary unsigned child binaries
         (node, python, etc.) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- App Sandbox network entitlements. Inert while the app is unsandboxed
         (network access is unrestricted anyway); kept harmlessly in case a
         sandboxed helper is ever added. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
