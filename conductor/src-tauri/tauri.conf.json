{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aran Terminal",
  "version": "2.3.2",
  "identifier": "studio.gearup.conductor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aran Terminal",
        "width": 800,
        "height": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "shell:spawn",
          "cmd": "**",
          "args": true
        }
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/arunkarnann/aran-terminal/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxMzMxRTg3Q0JFQjM2MkIKUldRck51dkxoeDR6c1cwdlpUT2NpS3pTVXhhOEZJbkl3NjJydGtiRWZ0ZmlOV2J6eEF0Wkx4YlcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
